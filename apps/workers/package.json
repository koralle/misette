{
  "name": "@misette/workers",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "pnpm dlx auth@1.7.2 generate --config src/auth.config.ts --output ../../packages/db/src/schema/auth.ts --adapter drizzle --dialect sqlite -y",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:clean:local": "rimraf .wrangler/state && rimraf .wrangler/local && rimraf ../web/.wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply misette --local --persist-to .wrangler/state && wrangler d1 migrations apply misette --local --persist-to .wrangler/local && wrangler d1 migrations apply misette --local --persist-to ../web/.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply misette --remote",
    "db:reset:local": "pnpm db:clean:local && pnpm db:migrate:local",
    "deploy": "wrangler deploy --minify",
    "dev": "echo 'Use pnpm --filter @misette/web dev (binding) or pnpm --filter @misette/workers dev:direct'",
    "dev:binding": "pnpm --filter @misette/web dev",
    "dev:direct": "pnpm db:reset:local && wrangler dev --env direct --port 8787 --persist-to .wrangler/state",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:auth",
    "@logtape/hono": "catalog:workers",
    "@logtape/logtape": "catalog:workers",
    "@misette/api-contract": "workspace:*",
    "@misette/db": "workspace:*",
    "@orpc/server": "catalog:orpc",
    "better-auth": "catalog:auth",
    "drizzle-orm": "catalog:db",
    "hono": "catalog:workers"
  },
  "devDependencies": {
    "@misette/workspace": "workspace:*",
    "@orpc/client": "catalog:orpc",
    "@orpc/contract": "catalog:orpc",
    "@types/node": "catalog:typescript",
    "miniflare": "catalog:workers",
    "rimraf": "catalog:tooling",
    "typescript": "catalog:typescript",
    "vitest": "catalog:testing",
    "wrangler": "catalog:workers"
  }
}
