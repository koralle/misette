{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "public/**", "index.html", "vite.config.*", "tsconfig.*", "wrangler.*", "worker/**"],
      "outputs": ["dist/**", ".wrangler/**"]
    },
    "cf-typegen": {
      "cache": false,
      "inputs": ["wrangler.jsonc", "src/**", "worker/**"]
    },
    "check": {
      "dependsOn": ["^check", "typecheck", "format:check"]
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "preview": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tsconfig.*", "worker/**"],
      "outputs": []
    }
  }
}
